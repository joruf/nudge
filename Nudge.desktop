[Desktop Entry]
Version=1.0
Type=Application
Name=Nudge
GenericName=Anti-idle tool
GenericName[de]=Anti-Leerlauf-Werkzeug
Comment=Keeps the workstation from going idle, with switchable techniques
Comment[de]=Hält die Arbeitsstation wach, mit umschaltbaren Techniken
Icon=nudge
# Self-locating, and that is the whole point of this line. %k is the path of this file, so the
# launcher finds the program next to itself no matter where the clone sits -- nothing to install
# first, nothing to edit by hand, and a moved directory keeps working. Python rather than a shell
# wrapper because the program is Python anyway; runpy under the name __main__ is what makes this
# identical to `python3 -m nudge`, right down to the window that installs missing packages. The
# path has to be taken back out of sys.argv afterwards, or the program's own argument parser sees
# it and refuses to start.
Exec=python3 -c "import os,runpy,sys,urllib.parse as u;p=sys.argv[1];p=u.unquote(p[7:]) if p.startswith('file://') else p;sys.path.insert(0,os.path.dirname(os.path.realpath(p)));del sys.argv[1:];runpy.run_module('nudge',run_name='__main__')" %k
Terminal=false
Categories=Utility;
Keywords=idle;awake;screensaver;lock;presence;
Keywords[de]=Leerlauf;wach;Bildschirmschoner;Sperre;
StartupNotify=true
StartupWMClass=Nudge
